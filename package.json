{
  "name": "marble-run",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Seeded 3D marble run racing, built on Babylon.js and Havok physics.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:rest": "node scripts/rest-test.mjs",
    "tune": "node scripts/tune.mjs",
    "tune:flow": "node scripts/flow-sweep.mjs",
    "tune:escapes": "node scripts/departures.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.3",
    "@babylonjs/havok": "^1.3.10"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
