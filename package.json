{
  "name": "marble-run",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "description": "Seeded 3D marble run racing, built on Babylon.js and Havok physics.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:rest": "node scripts/rest-test.mjs",
    "test:basin": "node scripts/basin-test.mjs",
    "shots:themes": "node scripts/theme-shots.mjs",
    "tune": "node scripts/tune.mjs",
    "tune:flow": "node scripts/flow-sweep.mjs",
    "tune:escapes": "node scripts/departures.mjs",
    "tune:speed": "node scripts/speed-source.mjs",
    "tune:baffles": "node scripts/baffle-sweep.mjs",
    "tune:queue": "node scripts/baffle-queue.mjs",
    "tune:camera": "node scripts/camera-motion.mjs",
    "palette": "node scripts/palette-check.mjs",
    "bump": "node scripts/bump-version.mjs",
    "hooks:install": "git config core.hooksPath scripts && chmod +x scripts/pre-commit"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.3",
    "@babylonjs/havok": "^1.3.10"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
